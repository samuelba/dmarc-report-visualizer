# Required. Generate with: openssl rand -base64 32 (same value in both)
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
# Recommended. Generate with: openssl rand -base64 48 (must differ from JWT_SECRET)
TOTP_ENCRYPTION_KEY=
# Set before you save an SMTP password. Generate with: openssl rand -base64 32
SMTP_ENCRYPTION_KEY=

# Required. Token from the Cloudflare tunnel you created
CLOUDFLARE_TUNNEL_TOKEN=
# Required. The tunnel's public hostname without scheme, e.g. dmarc.yourdomain.com
PUBLIC_HOST=

# Optional. Default to https://$PUBLIC_HOST and a host-only cookie.
# FRONTEND_URL=
# CORS_ORIGINS=
# SAML_ACS_URL=
# COOKIE_DOMAIN=

IPLOCATE_API_KEY=
IPAPICO_API_KEY=
IPWHOIS_API_KEY=
