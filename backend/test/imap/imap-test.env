# Backend environment for docker-compose.imap-test.yml (GreenMail + throwaway Postgres).
# Read by `npm run imap-test:backend` and by the IMAP e2e test (test/imap/setup-env.ts).
# Values here override backend/.env. Everything below is for local testing only.

NODE_ENV=development
PORT=3000

# Throwaway Postgres from docker-compose.imap-test.yml
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dmarc_imap_test
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
BACKUP_MANDATORY=false

# Test-only values (required at startup, never use them anywhere real)
JWT_SECRET=imap-test-only-not-a-real-secret
SMTP_ENCRYPTION_KEY=imap-test-only-not-a-real-key

# Keep the test self-contained: no Redis/SAML, no other ingestion paths,
# offline IP geolocation only (no report IPs are sent to external APIs)
REDIS_HOST=
ENABLE_FILE_WATCHER=false
ENABLE_GMAIL_DOWNLOADER=false
IP_LOOKUP_PROVIDER=geoip-lite
IP_LOOKUP_FALLBACK_PROVIDERS=
IPLOCATE_API_KEY=
IPAPICO_API_KEY=
IPWHOIS_API_KEY=

# IMAP downloader -> GreenMail (plain IMAP, any password is accepted)
ENABLE_IMAP_DOWNLOADER=true
IMAP_HOST=localhost
IMAP_PORT=13143
IMAP_TLS=false
IMAP_USER=dmarc@test.local
IMAP_PASSWORD=secret
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_PROCESSED_FOLDER=DMARC_Processed
IMAP_FAILED_FOLDER=DMARC_Failed
IMAP_POLL_INTERVAL_MS=10000
IMAP_FAILURE_THRESHOLD=3
IMAP_PROCESS_INLINE=true

# Used by the seed/inspect scripts and the e2e test
IMAP_TEST_SMTP_HOST=localhost
IMAP_TEST_SMTP_PORT=13025
