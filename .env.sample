# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
# Required. Must match POSTGRES_PASSWORD.
DATABASE_PASSWORD=
DATABASE_NAME=dmarc
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Backup Configuration
# Directory where database backups are stored
BACKUP_DIR=./backups
# Whether backup failure should prevent application startup (default: true)
BACKUP_MANDATORY=true
# Number of recent backups to keep (default: 10)
BACKUP_KEEP_COUNT=10

# PostgreSQL Configuration (for docker-compose)
POSTGRES_USER=postgres
# Required. Generate before the first start with: openssl rand -base64 32
# docker-compose.yml does not publish the Postgres port; to reach it from the
# host, see docker-compose.override.yml.example.
POSTGRES_PASSWORD=
POSTGRES_DB=dmarc

# Application Configuration
NODE_ENV=production
PORT=3000
# Number of reverse proxies in front of the backend. The client IP used for
# login rate limiting is read from X-Forwarded-For, skipping this many hops.
#   1     - only the bundled nginx (default)
#   2     - another proxy in front of it (Traefik, Caddy, Cloudflare Tunnel, ...)
#   false - clients connect to the backend directly
# Too low and all clients share one IP, so one attacker can lock everyone out
# of login. Too high and clients can spoof their IP. `true` is rejected.
TRUST_PROXY=1

# JWT Configuration
# Required. Generate before the first start with: openssl rand -base64 48
# The backend derives its token signing keys and the 2FA encryption key from it.
# Changing it later logs everyone out and breaks existing 2FA enrolments
# (see docs/site/deployment/secrets.md).
JWT_SECRET=
# Recommended. Encrypts stored 2FA secrets independently of JWT_SECRET, so
# JWT_SECRET can be rotated without breaking 2FA. Generate with:
# openssl rand -base64 48
# Existing 2FA secrets are re-encrypted automatically on the next start. Keep
# this value with your database backups: without it, 2FA users cannot sign in.
#TOTP_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# SAML Configuration
# docker-compose.yml comments out SAML_ENTITY_ID, SAML_ACS_URL and FRONTEND_URL.
# Uncomment them there, or these values never reach the backend.
# SAML Entity ID - unique identifier for this Service Provider
SAML_ENTITY_ID=dmarc-app
# SAML Assertion Consumer Service URL - where IdP sends SAML assertions (must be HTTPS in production)
SAML_ACS_URL=https://app.example.com/api/auth/saml/callback
# Disable SAML signature validation for testing (NOT recommended for production)
# SAML_DISABLE_SIGNATURE_VALIDATION=false
# Frontend URL for SAML redirects
FRONTEND_URL=https://app.example.com
# If SAML is enforced but not working, force enable password login
#FORCE_ENABLE_PASSWORD_LOGIN=false

# Redis Configuration (enable if using SAML/SSO)
#REDIS_HOST=redis
#REDIS_PORT=6379
#REDIS_PASSWORD=your-redis-password

# Password Configuration
BCRYPT_ROUNDS=10

# Rate Limiting Configuration
RATE_LIMIT_IP_MAX_ATTEMPTS=10
RATE_LIMIT_IP_WINDOW_MS=300000
RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=5
RATE_LIMIT_ACCOUNT_WINDOW_MS=300000
RATE_LIMIT_LOCK_DURATION_MS=900000

# Cookie Configuration
COOKIE_SECURE=true
# Leave empty for a cookie bound to the host in the address bar. A domain that
# does not match that host makes the browser drop the login cookie.
COOKIE_DOMAIN=

# CORS Configuration
# Comma-separated list of allowed origins, or * for all origins
CORS_ORIGINS=http://localhost

# MCP Server (optional, see docs/site/usage/mcp.md)
# Read-only access for AI assistants such as Claude, authenticated with personal API tokens.
# Off unless set to true: without it the MCP endpoint and the token routes do not exist.
MCP_ENABLED=false
# Extra browser origins allowed to call /api/mcp, comma-separated (CORS_ORIGINS are always allowed).
# Non-browser clients such as Claude Code send no Origin header and need nothing here.
# MCP_ALLOWED_ORIGINS=
# Requests per minute and user (all of a user's tokens together)
# MCP_RATE_LIMIT_PER_MIN=60
# Longest lifetime a user can choose for a token, in days
# API_TOKEN_MAX_TTL_DAYS=365

# Frontend Configuration
FRONTEND_PORT=80

# Report Size Limits (optional, see docs/site/ingestion/report-limits.md)
# Protects against decompression bombs and oversized reports on all ingestion paths.
# REPORT_MAX_FILE_BYTES=10485760
# REPORT_MAX_UNCOMPRESSED_BYTES=52428800
# REPORT_MAX_ZIP_ENTRIES=10
# REPORT_MAX_RECORDS=50000
# REPORT_MAX_MESSAGE_BYTES=26214400
# REPORT_FAILURE_ARCHIVE_MAX_FILES=500

# File Watcher Configuration
# Set to true to enable automatic processing of files dropped in FILE_WATCH_DIR
ENABLE_FILE_WATCHER=true
FILE_WATCH_DIR=reports/incoming
FILE_WATCH_DELETE_PROCESSED=true
FILE_WATCH_VERBOSE=false

# Report Sender Authentication (see docs/site/ingestion/sender-authentication.md)
# Checks that report emails really come from the organization named in the
# report (DKIM, or ARC records from a trusted relay).
#   off     - no checks; email reports are stored as unverified
#   flag    - store every report with its verdict (default)
#   enforce - reject email reports without sender evidence
REPORT_SENDER_AUTH=flag
# ARC sealers whose recorded results are trusted. Needed when reports reach
# you through a mailing list or forwarder, e.g. google.com for Google Groups.
REPORT_TRUSTED_ARC_SEALERS=
# Extra domains that relay reports to you. Managed domains are always excluded.
REPORT_RELAY_DOMAINS=

# Gmail Downloader Configuration
# Set to true to enable automatic downloading and processing of DMARC reports from Gmail
ENABLE_GMAIL_DOWNLOADER=false

# Gmail Authentication Mode
# Options: oauth (recommended for user accounts), service_account (for Google Workspace with domain-wide delegation)
GMAIL_AUTH_MODE=oauth

# Gmail OAuth Configuration (when GMAIL_AUTH_MODE=oauth)
# Required: Create OAuth 2.0 credentials in Google Cloud Console
# See docs/site/ingestion/gmail-api.md for how to obtain the refresh token.
GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-refresh-token
GMAIL_OAUTH_REDIRECT_URI=http://localhost

# Gmail Service Account Configuration (when GMAIL_AUTH_MODE=service_account)
# Option 1: Provide credentials directly in environment variables
GMAIL_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GMAIL_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----
GMAIL_DELEGATED_USER=user@yourdomain.com

# Option 2: Provide path to service account JSON file
# If set, this will override GMAIL_CLIENT_EMAIL and GMAIL_PRIVATE_KEY
GMAIL_CREDENTIALS_JSON_PATH=path/to/service-account-credentials.json

# Gmail Labels Configuration
# The label to search for incoming DMARC reports
GMAIL_LABEL='DMARC Reports'
# The label to apply to successfully processed messages
GMAIL_PROCESSED_LABEL='DMARC Processed'
# The label to apply to messages that failed processing after GMAIL_FAILURE_THRESHOLD attempts
GMAIL_FAILED_LABEL='DMARC Failed'

# Gmail Processing Configuration
# Polling interval in milliseconds (default: 300000 = 5 minutes)
GMAIL_POLL_INTERVAL_MS=300000
# Number of messages to fetch per page (1-500, default: 100)
GMAIL_LIST_PAGE_SIZE=100
# Gmail query string to filter messages. Empty uses:
#   has:attachment newer_than:5d -label:"<processed label>" -label:"<failed label>"
# GMAIL_QUERY=
# Process attachments inline instead of saving to FILE_WATCH_DIR (default: true)
GMAIL_PROCESS_INLINE=true
# Save original attachments to reports/processed/success after inline processing (default: false)
GMAIL_SAVE_ORIGINAL=false
# Remove source label after processing (default: true)
GMAIL_REMOVE_SOURCE_LABEL=true
# Number of processing failures before applying GMAIL_FAILED_LABEL (default: 3)
GMAIL_FAILURE_THRESHOLD=3

# IMAP Downloader Configuration
# Off unless set to true. Required when enabled: IMAP_HOST, IMAP_USER, IMAP_PASSWORD.
# Outlook.com and Microsoft 365 are not supported (they reject password logins).
ENABLE_IMAP_DOWNLOADER=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_PROCESSED_FOLDER=
IMAP_FAILED_FOLDER=
IMAP_POLL_INTERVAL_MS=300000
IMAP_PROCESS_INLINE=true
IMAP_SAVE_ORIGINAL=false
IMAP_FAILURE_THRESHOLD=3

# Reprocessing Configuration
# Number of parallel workers to use for reprocessing (default: a quarter of the CPU cores, at least 1)
REPROCESSING_WORKERS=1

# IP Lookup Service Configuration
# ip-api needs no key. iplocate needs IPLOCATE_API_KEY, also for the free tier.
IP_LOOKUP_PROVIDER=ip-api
# Required for the https://www.iplocate.io/ provider
IPLOCATE_API_KEY=
# Optional API key for https://ipapi.co/ provider
IPAPICO_API_KEY=
# Optional API key for https://ipwhois.io/ provider
IPWHOIS_API_KEY=
# Fallback providers in case the main one fails (comma-separated)
IP_LOOKUP_FALLBACK_PROVIDERS=ipwhois,ip-api,ipapi-co,geoip-lite
IP_LOOKUP_CACHE_DAYS=14

# SMTP Email Service Configuration
# Encryption key for storing SMTP credentials securely (32+ character random string)
# Generate with: openssl rand -base64 32
# Set it before you save an SMTP password. Invitation emails also need Redis.
# Changing it later means re-entering the SMTP password in the SMTP settings.
SMTP_ENCRYPTION_KEY=

# Optional TOTP tuning. Unset values use these defaults.
# TOTP_WINDOW=3
# TOTP_STEP=30
# TOTP_ISSUER=DMARC Dashboard

# Refresh-token theft detection. Unset means both are on.
# THEFT_DETECTION_ENABLED=true
# THEFT_DETECTION_INVALIDATE_FAMILY=true

# Use the stored IP lookup cache. Unset means on.
# IP_LOOKUP_USE_CACHE=true
